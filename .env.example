# ============================================================================
# FBM Ops - Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# chmod 600 .env

# --- Core Configuration ---
FBM_PROFILE=fb_profile
FBM_DB=fbm.sqlite
FBM_ENV=.env
FBM_SELECTORS=selectors.json
FBM_STATE=fbm_state.json

# --- Security ---
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_SECRET=change-me-in-production

# --- Facebook Login (for auto-relogin) ---
FBM_LOGIN_EMAIL=your-facebook-email@example.com
FBM_LOGIN_PASSWORD=your-facebook-password
FBM_TOTP_SECRET=your-totp-secret-key

# --- Alerting ---
ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# --- AI/LLM ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
INBOX_MODEL=gpt-4o-mini

# --- Order Tracking (Plus-address routing) ---
ORDER_ALIAS_DOMAIN=yourdomain.com

# --- Email (IMAP/SMTP) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Supplier Keys ---
SPOCKET_API_KEY=your-spocket-api-key
CJ_API_KEY=your-cj-api-key
ZENDROP_API_KEY=your-zendrop-api-key
DROPCOMMERCE_API_KEY=your-dropcommerce-api-key

# --- Stripe (Billing) ---
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PRICE_STARTER=price_starter_monthly
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_AGENCY=price_agency_monthly
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Sample Ordering ---
SAMPLE_BUDGET_MONTH=150
SAMPLE_MAX_COST=30
SAMPLE_ADDRESS=your-shipping-address
SAMPLE_LATENCY_LIMIT_DAYS=2

# --- Dashboard ---
DASH_USER=admin
DASH_PASS=change-me-in-production

# --- Backup ---
BACKUP_PASSWORD=change-me-in-production
BACKUP_KEEP=7

# --- Configuration ---
ACCOUNTS=main
CITY=memphis
REGION=TN