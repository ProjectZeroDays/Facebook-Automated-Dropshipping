"""llm.py — one interface; provider chosen by plan."""
TASKS = {
 "classify":      {"schema": {"intent": "str", "confidence": "float"}},
 "draft_reply":   {"schema": {"reply": "str", "confidence": "float", "needs_human": "bool"}},
 "generate_copy": {"schema": {"titles": ["str"], "description": "str"}},
 "extract_track": {"schema": {"carrier": "str", "number": "str"}},
 "answer_faq":    {"schema": {"answer": "str", "grounded": "bool"}},
 "suggest_field": {"schema": {"value": "str"}},
}

def provider_for(plan, env):
    if plan == "starter":                      # $49 = BYO key
        return "byo" if env.get("OPENAI_API_KEY") or env.get("ANTHROPIC_API_KEY") else "local"
    return "local"                             # $99/$199 = bundled, unlimited
